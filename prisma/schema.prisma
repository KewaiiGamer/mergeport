// Mergeport schema.
// Concepts kept separate on purpose: Workspace, Project (app concept), GithubOwner (GitHub account),
// Repository (GitHub repo), Member (dashboard member), RepositoryGrant, GithubConnection.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  REVOKED
}

enum OwnerType {
  USER
  ORGANIZATION
  UNKNOWN
}

enum Visibility {
  PUBLIC
  PRIVATE
  INTERNAL
  UNKNOWN
}

enum TrackingStatus {
  ACTIVE
  DISCONNECTED
  REMOVED
}



enum WorkItemType {
  ISSUE
  PULL_REQUEST
}

enum WorkItemState {
  OPEN
  CLOSED
  MERGED
}

enum ChecksState {
  NONE
  PENDING
  SUCCESS
  FAILURE
  UNKNOWN
}

enum MergeableState {
  MERGEABLE
  CONFLICTING
  UNKNOWN
}

enum CommentKind {
  ISSUE_COMMENT
  REVIEW_COMMENT
  REVIEW
  EVENT
}

enum ReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
  PENDING
}

enum RuleScope {
  REPOSITORY
  OWNER
  PROJECT
  WORKSPACE
}

enum ApprovalSemantics {
  ANY
  ALL
}

enum ReviewerKind {
  USER
  TEAM
  EXTERNAL_ROLE
}

enum WaitingStatus {
  PENDING
  SATISFIED
  CANCELLED
  STALE
}

enum WaitingSource {
  RULE
  MANUAL
}


enum UpstreamEvidence {
  ANCESTRY_EXACT
  PATCH_EQUIVALENT_POSSIBLE
  MANUAL_ACK
  NOT_DETECTED
  UNKNOWN
}

enum TriageStatus {
  UNTRIAGED
  WATCHING
  RELEVANT
  ADDRESSED
  IGNORED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members       Member[]
  projects      Project[]
  repositories  Repository[]
  reviewRules   ReviewRule[]
  waitingRules WaitingRule[]
  milestones    DashboardMilestone[]
  audit         AuditLog[]
  notifications Notification[]
}

model User {
  id        String   @id @default(cuid())
  githubId  BigInt   @unique
  login     String
  name      String?
  avatarUrl String?
  timezone  String   @default("UTC")
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  members       Member[]
  sessions      Session[]
  devices       Device[]
  savedFilters  SavedFilter[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfToken String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Member {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants          RepositoryGrant[]
  projects        ProjectMember[]
  planningCreated PlanningItem[]      @relation("PlanningCreatedBy")
  ownedMilestones DashboardMilestone[]

  @@unique([workspaceId, userId])
}



model GithubOwner {
  id        String    @id @default(cuid())
  githubId  BigInt    @unique
  login     String
  type      OwnerType @default(UNKNOWN)
  avatarUrl String?
  synthetic Boolean   @default(false)

  repositories Repository[]
}

model Repository {
  id             String         @id @default(cuid())
  workspaceId    String
  githubId       BigInt
  ownerId        String
  name           String
  fullName       String
  htmlUrl        String
  description    String?
  visibility     Visibility     @default(UNKNOWN)
  isFork         Boolean        @default(false)
  parentGithubId BigInt?
  parentFullName String?
  defaultBranch  String?
  archived       Boolean        @default(false)
  permissions    Json? // permissions of the credential that last saw it
  trackingStatus TrackingStatus @default(ACTIVE)
  statusDetail   String?
  isDemo         Boolean        @default(false)
  spaceId        String? // coordination space that declares (shares) this repository; null = local only
  lastSyncedAt   DateTime?
  syncError      String?
  rateLimited    Boolean        @default(false)
  createdAt      DateTime       @default(now())

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       GithubOwner        @relation(fields: [ownerId], references: [id])
  projects    ProjectRepository[]
  grants      RepositoryGrant[]
  workItems   WorkItem[]
  branches    Branch[]
  reviewRules ReviewRule[]
  waitingRules WaitingRule[]
  milestoneLinks MilestoneRepoLink[]
  forkMappings   ForkMapping[] @relation("ForkSide")
  upstreamOf     ForkMapping[] @relation("UpstreamSide")
  snapshots      WorktreeSnapshot[]
  deviceMappings DeviceRepoMapping[]

  @@unique([workspaceId, githubId])
  @@index([workspaceId, trackingStatus])
}


model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  spaceId     String? // null = local only
  createdAt   DateTime @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories ProjectRepository[]
  members      ProjectMember[]
  columns      PlanningColumn[]
  items        PlanningItem[]
  milestones   DashboardMilestone[]
  reviewRules  ReviewRule[]
  waitingRules WaitingRule[]

  @@unique([workspaceId, slug])
}

model ProjectRepository {
  projectId    String
  repositoryId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([projectId, repositoryId])
}

model ProjectMember {
  projectId String
  memberId  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
}

model RepositoryGrant {
  id           String    @id @default(cuid())
  memberId     String
  repositoryId String
  canManageWork Boolean  @default(false)
  canReview    Boolean   @default(false)
  grantedById  String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([memberId, repositoryId])
  @@index([repositoryId])
}

model WorkItem {
  id             String         @id @default(cuid())
  repositoryId   String
  githubId       BigInt
  number         Int
  type           WorkItemType
  title          String
  body           String?
  state          WorkItemState  @default(OPEN)
  draft          Boolean        @default(false)
  authorLogin    String?
  authorGithubId BigInt?
  authorAvatar   String?
  labels         Json           @default("[]") // [{name,color}]
  assignees      Json           @default("[]") // [login]
  labelNames     String         @default("") // "|bug|docs|" lowercase search index of labels (SQLite cannot filter JSON arrays)
  assigneeLogins String         @default("") // "|alice|bob|" lowercase search index of assignees
  milestoneNumber Int?
  milestoneTitle String?
  htmlUrl        String
  headSha        String?
  headRef        String?
  baseRef        String?
  mergeable      MergeableState @default(UNKNOWN)
  checksState    ChecksState    @default(NONE)
  additions      Int?
  deletions      Int?
  changedFiles   Int?
  createdAtGh    DateTime
  updatedAtGh    DateTime // source-of-truth timestamp used to reject stale writes
  closedAtGh     DateTime?
  mergedAtGh     DateTime?
  syncedAt       DateTime       @default(now())

  repository      Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  comments        WorkItemComment[]
  reviewRequests  ReviewRequest[]
  waiting         WaitingRecord[]
  planningItems   PlanningItem[]

  @@unique([repositoryId, number])
  @@unique([repositoryId, githubId])
  @@index([repositoryId, state, type])
}

model WorkItemComment {
  id         String      @id @default(cuid())
  workItemId String
  githubId   BigInt
  kind       CommentKind
  authorLogin String?
  body       String?
  reviewState ReviewState?
  commitSha  String?
  path       String?
  line       Int?
  threadKey  String?
  createdAtGh DateTime
  updatedAtGh DateTime

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, kind, githubId])
  @@index([workItemId, createdAtGh])
}

model ReviewRequest {
  id           String       @id @default(cuid())
  workItemId   String
  kind         ReviewerKind
  reviewerRef  String // login or team slug
  requestedAt  DateTime
  removedAt    DateTime?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

model Branch {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  sha          String
  isDefault    Boolean  @default(false)
  fetchedAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
}

/// "Everything that matches waits on these people until it is merged or closed", independent of review requests: for work
/// that sits with someone else (for example every open pull request in a repository whose maintainer merges). Nothing is
/// built in; every rule is data the person writes.
model WaitingRule {
  id            String    @id @default(cuid())
  workspaceId   String
  scope         RuleScope
  repositoryId  String?
  ownerLogin    String?
  projectId     String?
  itemType      String    @default("PULL_REQUEST") // PULL_REQUEST | ISSUE | ANY
  labels        Json      @default("[]") // string[]; empty = any
  authors       Json      @default("[]") // logins; empty = any author
  includeDrafts Boolean   @default(false)
  waitingOn     Json // [{kind:USER|TEAM|EXTERNAL_ROLE, ref}]
  reason        String
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
}

model ReviewRule {
  id          String            @id @default(cuid())
  workspaceId String
  scope       RuleScope
  repositoryId String?
  ownerLogin  String?
  projectId   String?
  labels      Json              @default("[]") // string[] (SQLite has no scalar lists)
  reviewers   Json // [{kind:USER|TEAM|EXTERNAL_ROLE, ref, display?}]
  semantics   ApprovalSemantics @default(ANY)
  reason      String
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
}

model WaitingRecord {
  id             String        @id @default(cuid())
  workspaceId    String
  workItemId     String?
  planningItemId String?
  source         WaitingSource
  ruleId         String?
  reviewerKind   ReviewerKind
  reviewerRef    String
  reason         String
  status         WaitingStatus @default(PENDING)
  startedAt      DateTime      @default(now())
  clearedAt      DateTime?
  clearedById    String?
  clearReason    String?

  workItem     WorkItem?     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  planningItem PlanningItem? @relation(fields: [planningItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workItemId])
}

model PlanningColumn {
  id        String @id @default(cuid())
  projectId String
  key       String
  name      String
  position  Int

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   PlanningItem[]

  @@unique([projectId, key])
}

model PlanningItem {
  id           String   @id @default(cuid())
  projectId    String
  columnId     String
  position     Float
  version      Int      @default(1) // optimistic concurrency
  title        String // used when workItemId is null (internal draft task)
  description  String?
  workItemId   String? // GitHub issue/PR link; inherits repository restrictions
  workRepoGithubId BigInt? // stable reference to the linked work item, resolved to workItemId after source sync
  workNumber   Int?
  assigneeLogin String?
  assignedByLogin String? // who last set the assignee (GitHub login, so it reads right on every computer)
  authorLogin  String? // who created the task (GitHub login)
  labels       Json     @default("[]") // [string]
  priority     Int      @default(0)
  dueDate      DateTime?
  milestoneId  String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    PlanningColumn       @relation(fields: [columnId], references: [id])
  workItem  WorkItem?            @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  milestone DashboardMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy Member               @relation("PlanningCreatedBy", fields: [createdById], references: [id])
  blocks    PlanningLink[]       @relation("LinkFrom")
  blockedBy PlanningLink[]       @relation("LinkTo")
  waiting   WaitingRecord[]
  comments  TaskComment[]
  checklist TaskCheckItem[]

  @@index([projectId, columnId])
  @@index([assigneeLogin])
}

/// Immutable GitHub answers keyed by commit (diffs, file contents, commit lists), so reopening a pull request or a file costs
/// nothing. Safe to delete at any time; it is rebuilt on demand and pruned by age and size.
model GitCache {
  key        String   @id
  payload    Json
  bytes      Int
  createdAt  DateTime @default(now())
  accessedAt DateTime @default(now())

  @@index([accessedAt])
}

/// One checkbox on a task. One row (and one synced file) per item, so two people ticking different items never conflict.
model TaskCheckItem {
  id          String    @id @default(cuid())
  itemId      String
  text        String
  done        Boolean   @default(false)
  position    Float
  doneByLogin String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  item PlanningItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

/// A comment on a task, or a short system line ("assigned to alice"). One row per entry so two people never edit the same file.
model TaskComment {
  id          String    @id @default(cuid())
  itemId      String
  authorLogin String
  kind        String    @default("COMMENT") // COMMENT | EVENT
  body        String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?

  item PlanningItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model PlanningLink {
  fromId String // blocker
  toId   String // blocked

  from PlanningItem @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   PlanningItem @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model DashboardMilestone {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  description String?
  ownerId     String?
  startDate   DateTime?
  targetDate  DateTime?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner     Member?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  items     PlanningItem[]
  repoLinks MilestoneRepoLink[]
}

model MilestoneRepoLink {
  milestoneId     String
  repositoryId    String
  githubMilestoneNumber Int

  milestone  DashboardMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  repository Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([milestoneId, repositoryId])
}

model ForkMapping {
  id             String  @id @default(cuid())
  forkRepoId     String
  upstreamRepoId String
  forkBranch     String
  upstreamBranch String

  fork     Repository @relation("ForkSide", fields: [forkRepoId], references: [id], onDelete: Cascade)
  upstream Repository @relation("UpstreamSide", fields: [upstreamRepoId], references: [id], onDelete: Cascade)
  comparisons ForkComparison[]
  upstreamPrs UpstreamPrState[]
  triage      UpstreamIssueTriage[]

  @@unique([forkRepoId, upstreamRepoId, forkBranch, upstreamBranch])
}

model ForkComparison {
  id         String   @id @default(cuid())
  mappingId  String
  status     String // identical | ahead | behind | diverged | unrelated | unknown | error
  aheadBy    Int?
  behindBy   Int?
  baseSha    String? // upstream tip at compare time
  headSha    String? // fork tip at compare time
  truncated  Boolean  @default(false)
  error      String?
  comparedAt DateTime @default(now())

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId, comparedAt])
}

model UpstreamPrState {
  id          String           @id @default(cuid())
  mappingId   String
  number      Int
  title       String
  state       String // open | merged | closed
  htmlUrl     String
  mergeSha    String?
  mergedAtGh  DateTime?
  evidence    UpstreamEvidence @default(UNKNOWN)
  evidenceNote String?
  ackedById   String?

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, number])
}

model UpstreamIssueTriage {
  id           String       @id @default(cuid())
  mappingId    String
  issueNumber  Int
  title        String
  htmlUrl      String
  status       TriageStatus @default(UNTRIAGED)
  linkedWorkItemId String?
  note         String?
  decidedById  String?
  updatedAt    DateTime     @updatedAt

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, issueNumber])
}

/// "This computer". Worktree scanning is local: the app runs on the machine that has the folders.
model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roots     DeviceRepoMapping[]
  snapshots WorktreeSnapshot[]
}

model DeviceRepoMapping {
  id           String @id @default(cuid())
  deviceId     String
  repositoryId String
  rootPath     String? // absolute path chosen by the person; never leaves this machine

  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([deviceId, repositoryId])
}

model WorktreeSnapshot {
  id           String   @id @default(cuid())
  deviceId     String
  repositoryId String
  capturedAt   DateTime
  data         Json // {worktrees:[{path,branch,head,detached,locked,prunable,dirty:{...},tracking,aheadBehind}]}

  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([deviceId, repositoryId])
}

model SavedFilter {
  id     String @id @default(cuid())
  userId String
  scope  String
  name   String
  query  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  repositoryId String? // authorization context: filtered by current grants at read time
  kind        String
  title       String
  href        String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  dedupeKey   String?   @unique
  intervalMs  Int? // recurring job: re-queued by the runner after every run
  dirty       Boolean   @default(false) // a trigger arrived while the job was RUNNING: run again right after
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}


model PublicCacheEntry {
  key       String   @id
  etag      String?
  body      Json
  fetchedAt DateTime @default(now())
}

/// Last known result of a network discovery (repositories, invitations, space candidates), so pages render from local
/// state. `fetchedAt` is the last SUCCESSFUL fetch and stays put while later attempts fail.
model DiscoveryCache {
  key         String    @id // "repos" | "invitations" | "candidates" | "inv-status:<spaceId>"
  payload     Json?
  fetchedAt   DateTime?
  state       String    @default("EMPTY") // EMPTY | FRESH | RETRYING | OFFLINE | AUTH | RATE_LIMITED | ERROR
  error       String?
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model RateLimitState {
  key       String   @id // e.g. "public-ip", "installation:123"
  remaining Int
  limit     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

enum SpaceKind {
  COMMON
  RESTRICTED
}

enum SpaceAccess {
  OK
  REVOKED
  NO_ACCESS
  SCHEMA_NEWER
}

enum OpKind {
  UPSERT
  DELETE
}

enum OpStatus {
  PENDING
  SENT
  CONFLICT
  QUARANTINED
  FAILED
}

enum TeamMode {
  PERSONAL
  TEAM
}

enum SpaceBackend {
  GITHUB
  HUB
}

enum TeamBackend {
  GITHUB
  HUB
}

/// A coordination space = one private GitHub repository with exactly one audience (its collaborators).
model Space {
  id             String      @id @default(cuid())
  remoteId       String // spaceId from the manifest
  teamRemoteId   String
  kind           SpaceKind
  name           String
  repoOwner      String
  repoName       String
  repoGithubId   BigInt?
  branch         String      @default("main")
  /// Taken from GitHub's permissions for THIS account, never from a role string in the repository.
  canWrite       Boolean     @default(false)
  canAdmin       Boolean     @default(false)
  access         SpaceAccess @default(OK)
  headSha        String?
  etag           String? // conditional head check
  lastPolledAt   DateTime?
  lastChangedAt  DateTime?
  pollIntervalMs Int         @default(30000)
  unchangedPolls Int         @default(0)
  nextPollAt     DateTime?
  lastError      String?
  rateLimitedUntil DateTime?
  createdAt      DateTime    @default(now())
  backend        SpaceBackend @default(GITHUB)
  /// Hub space id (empty for GitHub spaces).
  hubSpaceId     String      @default("")
  /// Last hub change sequence applied locally.
  hubCursor      BigInt      @default(0)
  /// The op the hub recorded at hubCursor: lets the hub tell that its history is no longer the one this cursor points into (a restore).
  hubCursorOp    String      @default("")
  /// The hub process this cursor was read from. A different one may be serving a restored database.
  hubEpoch       String      @default("")

  restores  HubRestore[]
  entities  SyncEntity[]
  outbox    OutboxOp[]
  conflicts SyncConflict[]

  @@unique([backend, repoOwner, repoName, hubSpaceId])
}

/// What we last agreed on with the remote for one entity file: enables 3-way merges.
model SyncEntity {
  spaceId     String
  type        String
  entityId    String
  path        String
  remoteSha   String?
  baseVersion Int     @default(0)
  baseData    Json?
  meta        Json? // { applied: string[] } recent operation ids already in the remote file
  deleted     Boolean @default(false)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, type, entityId])
}

/// Durable local outbox. Rows are written BEFORE any network call.
model OutboxOp {
  id          String   @id // idempotent operation id
  spaceId     String
  entityType  String
  entityId    String
  kind        OpKind
  data        Json?
  baseVersion Int      @default(0)
  status      OpStatus @default(PENDING)
  attempts    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
}

model SyncConflict {
  id            String    @id @default(cuid())
  spaceId       String
  entityType    String
  entityId      String
  fields        Json // string[] of conflicting keys
  base          Json
  local         Json
  remote        Json
  remoteVersion Int
  opId          String?
  status        String    @default("OPEN") // OPEN | RESOLVED
  resolution    String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
}

/// The hub's history stopped being the one this computer had followed (restored from a backup). What the hub's state replaced is kept here.
model HubRestore {
  id         String   @id @default(cuid())
  spaceId    String
  at         DateTime @default(now())
  /// Entities whose local copy was newer than the restored hub (or absent from it) and were replaced by the hub's state.
  rolledBack Int
  /// Entities with unsent local edits: these were kept and merged against the restored state.
  kept       Int
  /// [{ type, entityId, deleted, data }]: the local copies that were replaced (capped).
  detail     Json
  status     String   @default("OPEN") // OPEN | RESENT | DISMISSED
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
}

model TeamConfig {
  id            String   @id @default("team")
  mode          TeamMode @default(PERSONAL)
  teamRemoteId  String?
  name          String?
  ownerLogin    String?
  commonSpaceId String?
  pollSeconds   Int      @default(30)
  backend       TeamBackend @default(GITHUB)
  hubOrigin     String?
  updatedAt     DateTime @updatedAt
}

/// The one hub login of this client; `cipher` is the encrypted hub session token.
model HubSession {
  id        String   @id @default("session")
  origin    String
  cipher    String
  githubId  BigInt
  login     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
