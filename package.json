{
  "name": "mergeport",
  "version": "0.1.0",
  "private": true,
  "description": "Shared GitHub project control center",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -H 127.0.0.1 -p 3000",
    "local": "node --import tsx scripts/start-local.ts",
    "local:demo": "node --import tsx scripts/start-local.ts --demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "migrate:from-postgres": "tsx scripts/migrate-from-postgres.ts",
    "test:live": "vitest run tests/live",
    "hub": "node --import tsx hub/src/main.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.63.0",
    "marked": "^16.4.1",
    "next": "16.4.3",
    "octokit": "^5.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.17.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  }
}
